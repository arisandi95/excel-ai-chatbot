APP_NAME=Laravel
APP_ENV=local
APP_KEY=XXXXX
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ====================================
# Konfigurasi N8N Chatbot
# ====================================
# URL webhook n8n untuk memproses pertanyaan chat Excel
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/excel-chat

# Path folder penyimpanan file Excel (relatif terhadap root project)
UPLOAD_EXCEL_PATH=uploads

# RAG selection: RAG_KEYWORD or RAG_PAGEINDEX
RAG_METHOD=RAG_KEYWORD

# USE_LOCAL_OLLAMA=true
# OLLAMA_API_URL=
# OLLAMA_MODEL="qwen2.5:3b"
# OLLAMA_MODEL="llama3.1"
# === Ollama Parameters (anti-halusinasi) ===
# Temperature 0.0 = deterministik, tidak mengarang
# OLLAMA_TEMPERATURE=0.0
# Max tokens cukup besar untuk jawaban komprehensif
# OLLAMA_MAX_TOKENS=2048
# Gunakan API chat HTTP (v1/chat/completions)
# OLLAMA_USE_HTTP=true

# ====================================
# Konfigurasi Ollama Cloud
# ====================================
USE_OLLAMA_CLOUD=true
OLLAMA_CLOUD_API_URL=https://api.ollama.com
OLLAMA_CLOUD_API_KEY=XXX
OLLAMA_CLOUD_MODEL=minimax-m3:cloud
OLLAMA_CLOUD_TEMPERATURE=0.0
OLLAMA_CLOUD_MAX_TOKENS=4096
